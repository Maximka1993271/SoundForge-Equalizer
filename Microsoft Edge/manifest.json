{
  "manifest_version": 3,
  "name": "SoundForge Equalizer",
  "version": "3.22.8",
  "description": "Премиальный 10-полосный эквалайзер для всех сайтов. Точная настройка частот, глубокий бас и чистые верха - звук, который вы заслужили.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "webNavigation",
    "scripting",
    "alarms",
    "notifications",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/SoundForge.png",
        "icons/SoundForge-off.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Активация расширения"
    },
    "toggle_eq": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Включить/выключить эквалайзер"
    },
    "next_preset": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Следующий пресет"
    },
    "reset_settings": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Сбросить все настройки"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SoundForge EQ",
    "default_icon": {
      "16": "icons/SoundForge.png",
      "48": "icons/SoundForge.png",
      "128": "icons/SoundForge.png"
    }
  },
  "icons": {
    "16": "icons/SoundForge.png",
    "48": "icons/SoundForge.png",
    "128": "icons/SoundForge.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "88"
}